      m_Calls: []
  m_text: "A cada 1000 anos, uma poderosa entidade faz com que ovos misteriosos caiam
    sobre os quatro cantos da terra. \n\nEsses ovos cont\xE9m criaturas lend\xE1rias
    com poderes inimagin\xE1veis. \r\n\nAqueles que encontram esses ovos de criaturas,
    as treinam e as usam em batalhas para decidir quem \xE9 o melhor\u2026\r\n\n\u2026com
    a promessa de ser transformado em uma lenda pela Entidade, e ser levado para
    morar com ela no firmamento eternamente."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: af229c826afc3e04daf0c11580946892, type: 2}
